+/// Newer Codex rollouts wrap conversation messages in typed completion events.
+/// Use those events rather than raw `response_item/message` records: the latter
+/// duplicate conversation text and also include injected prompt instructions.
+fn parse_completed_message(
+    payload: &serde_json::Value,
+    timestamp: Option<DateTime<Utc>>,
+) -> Option<ChatMessage> {
+    let item = payload.get("item")?;
+    let role = match item.get("type")?.as_str()? {
+        "UserMessage" => "user",
+        "AgentMessage" => "assistant",
+        _ => return None,
+    };
+    let blocks: Vec<ContentBlock> = item
+        .get("content")?
+        .as_array()?
+        .iter()
+        .filter_map(|content| {
+            match content.get("type")?.as_str()? {
+                "text" | "Text" => {}
+                _ => return None,
+            }
+            let text = content.get("text")?.as_str()?;
+            if text.trim().is_empty() {
+                return None;
+            }
+            Some(ContentBlock::Text {
+                text: text.to_string(),
+            })
+        })
+        .collect();
+
+    if blocks.is_empty() {
+        return None;
+    }
+
+    Some(ChatMessage {
+        role: role.to_string(),
+        timestamp,
+        blocks,
+    })
+}
