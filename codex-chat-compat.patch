+    #[test]
+    fn codex_completed_messages_reach_history_and_live_updates() {
+        use std::io::Write;
+
+        let dir = tempfile::TempDir::new().unwrap();
+        let path = dir.path().join("rollout.jsonl");
+        let user = r#"{"type":"event_msg","payload":{"type":"item_completed","item":{"type":"UserMessage","content":[{"type":"text","text":"Hello"}]}}}"#;
+        std::fs::write(&path, format!("{user}\n")).unwrap();
+        let mut reader = BufReader::new(File::open(&path).unwrap());
+        let history = read_all_messages(&mut reader, &AiTool::Codex);
+        assert_eq!(history.len(), 1);
+        assert_eq!(history[0].role, "user");
+        let mut pos = reader.stream_position().unwrap();
+
+        let assistant = r#"{"type":"event_msg","payload":{"type":"item_completed","item":{"type":"AgentMessage","phase":"final_answer","content":[{"type":"Text","text":"Hi!"}]}}}"#;
+        let raw = r#"{"type":"response_item","payload":{"type":"message","role":"assistant","content":[{"type":"output_text","text":"Hi!"}]}}"#;
+        let mut file = std::fs::OpenOptions::new()
+            .append(true)
+            .open(&path)
+            .unwrap();
+        writeln!(file, "{assistant}\n{raw}").unwrap();
+        let live = read_new_lines(&path, &mut pos, &AiTool::Codex).unwrap();
+        assert_eq!(live.len(), 1);
+        assert_eq!(live[0].role, "assistant");
+        assert_eq!(
+            serde_json::to_value(&live[0].blocks).unwrap(),
+            serde_json::json!([
+                {"type":"text","text":"Hi!"}
+            ])
+        );
+        assert!(read_new_lines(&path, &mut pos, &AiTool::Codex)
+            .unwrap()
+            .is_empty());
+
+        // Reopening the chat should replay each conversation message once.
+        let mut reader = BufReader::new(File::open(&path).unwrap());
+        let history = read_all_messages(&mut reader, &AiTool::Codex);
+        assert_eq!(history.len(), 2);
+        assert_eq!(history[0].role, "user");
+        assert_eq!(history[1].role, "assistant");
+    }
