{
  "schemaVersion": 1,
  "supportedLinuxFamilies": ["debian", "ubuntu"],
  "aptPackages": ["build-essential", "pkg-config", "libssl-dev", "ca-certificates", "curl", "python3", "python3-venv", "tmux", "git", "cron", "ffmpeg", "ripgrep", "xz-utils", "openssl", "systemd"],
  "pythonPackages": {"websockets": "14.2"},
  "rust": {"version": "1.95.0", "minimum": "1.85.0", "installer": "https://sh.rustup.rs"},
  "node": {"version": "24.21.0", "minimumMajor": 22, "distribution": "https://nodejs.org/dist"},
  "agents": {
    "codex": {"package": "@openai/codex", "version": "0.162.1", "docs": "https://learn.chatgpt.com/docs/codex/cli"},
    "claude": {"package": "@anthropic-ai/claude-code", "version": "2.1.295", "docs": "https://code.claude.com/docs/en/setup#install-with-npm"},
    "opencode": {"package": "opencode-ai", "version": "1.18.35", "docs": "https://opencode.ai/docs/"}
  },
  "files": [
    {"source": "scripts/chat-binding-hook.py", "destination": "hooks/chat-binding-hook.py", "mode": "755"},
    {"source": "scripts/agent-ui-mcp.py", "destination": "ui/agent-ui-mcp.py", "mode": "755"},
    {"source": "scripts/reload-codex-mcp.py", "destination": "hooks/reload-codex-mcp.py", "mode": "755"},
    {"source": "android-native/app/src/main/assets/ui", "destination": "ui", "mode": "644", "directory": true}
  ]
}
