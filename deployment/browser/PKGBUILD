# Repackage the checksum-pinned runtime and viewer; build as the service user.
pkgname=agentshell-kasmvnc
pkgver=1.5.0
pkgrel=2
pkgdesc='Pinned KasmVNC runtime and viewer for AgentShell'
arch=('x86_64')
url='https://github.com/kasmtech/KasmVNC'
license=('GPL-2.0-or-later')
depends=('libxcrypt-compat' 'bubblewrap')
options=('!strip' '!debug')
source=("https://github.com/kasmtech/KasmVNC/releases/download/v${pkgver}/kasmvncserver_jammy_${pkgver}_amd64.deb")
sha256sums=('485c190b1d9269fc40fc7205f850ecf71292d737cdb5482e778f2e52f128cd8a')
package() {
  mkdir -p "$srcdir/payload"
  bsdtar -xf "$srcdir/data.tar.zst" -C "$srcdir/payload"
  install -Dm755 "$srcdir/payload/usr/bin/Xkasmvnc" "$pkgdir/usr/bin/Xkasmvnc"
  install -Dm755 "$srcdir/payload/usr/bin/kasmvncpasswd" "$pkgdir/usr/bin/kasmvncpasswd"
  ln -s Xkasmvnc "$pkgdir/usr/bin/Xvnc"
  mkdir -p "$pkgdir/usr/share/kasmvnc"
  cp -a "$srcdir/payload/usr/share/kasmvnc/www" "$pkgdir/usr/share/kasmvnc/"
  install -Dm644 "$srcdir/payload/usr/share/doc/kasmvncserver/copyright" "$pkgdir/usr/share/licenses/$pkgname/copyright"
}
